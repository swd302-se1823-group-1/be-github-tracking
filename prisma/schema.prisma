// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

generator dbml {
  provider    = "prisma-dbml-generator"
  output      = "../dbml"
  projectName = "GitHub Tracking System"
  manyToMany  = false
}

// ============================================================================
// Core User Models
// ============================================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  password_hash String?   @db.VarChar(255)
  full_name     String?   @db.VarChar(255)
  role          UserRole  @default(STUDENT)
  avatar_url    String?   @db.VarChar(500)
  provider      String?   @db.VarChar(50) // 'google', 'facebook', 'local'
  provider_id   String?   @db.VarChar(255)
  is_active     Boolean   @default(true)
  deleted_at    DateTime?
  deleted_by_id String?   @db.Uuid
  deleted_by    User?     @relation("DeletedBy", fields: [deleted_by_id], references: [id], onDelete: NoAction)
  deleted_user  User[]    @relation("DeletedBy")
  created_at    DateTime  @default(now())
  created_by_id String?   @db.Uuid
  created_by    User?     @relation("CreatedBy", fields: [created_by_id], references: [id], onDelete: NoAction)
  created_user  User[]    @relation("CreatedBy")
  updated_at    DateTime  @default(now()) @updatedAt
  updated_by_id String?   @db.Uuid
  updated_by    User?     @relation("UpdatedBy", fields: [updated_by_id], references: [id], onDelete: NoAction)
  updated_user  User[]    @relation("UpdatedBy")

  // Relations
  student  Student?
  lecturer Lecturer?
  refresh_tokens RefreshToken[]

  // Opposite relations for student audit fields
  /// @hide
  deleted_students        Student[]       @relation("StudentDeletedBy")
  /// @hide
  created_students        Student[]       @relation("StudentCreatedBy")
  /// @hide
  updated_students        Student[]       @relation("StudentUpdatedBy")
  // Opposite relations for lecturer audit fields
  /// @hide
  deleted_lecturers       Lecturer[]      @relation("LecturerDeletedBy")
  /// @hide
  created_lecturers       Lecturer[]      @relation("LecturerCreatedBy")
  /// @hide
  updated_lecturers       Lecturer[]      @relation("LecturerUpdatedBy")
  // Opposite relations for github mapping audit fields
  /// @hide
  deleted_github_mappings GithubMapping[] @relation("GithubMappingDeletedBy")
  /// @hide
  created_github_mappings GithubMapping[] @relation("GithubMappingCreatedBy")
  /// @hide
  updated_github_mappings GithubMapping[] @relation("GithubMappingUpdatedBy")

  // Opposite relations for semester audit fields
  /// @hide
  deleted_semesters Semester[] @relation("SemesterDeletedBy")
  /// @hide
  created_semesters Semester[] @relation("SemesterCreatedBy")
  /// @hide
  updated_semesters Semester[] @relation("SemesterUpdatedBy")

  // Opposite relations for class audit fields
  /// @hide
  deleted_classes Class[] @relation("ClassDeletedBy")
  /// @hide
  created_classes Class[] @relation("ClassCreatedBy")
  /// @hide
  updated_classes Class[] @relation("ClassUpdatedBy")

  // Opposite relations for course audit fields
  /// @hide
  deleted_courses Course[] @relation("CourseDeletedBy")
  /// @hide
  created_courses Course[] @relation("CourseCreatedBy")
  /// @hide
  updated_courses Course[] @relation("CourseUpdatedBy")

  // Opposite relations for enrollment audit fields
  /// @hide
  deleted_enrollments Enrollment[] @relation("EnrollmentDeletedBy")
  /// @hide
  created_enrollments Enrollment[] @relation("EnrollmentCreatedBy")
  updated_enrollments Enrollment[] @relation("EnrollmentUpdatedBy")

  // Opposite relations for project audit fields
  /// @hide
  deleted_projects Project[] @relation("ProjectDeletedBy")
  /// @hide
  created_projects Project[] @relation("ProjectCreatedBy")
  /// @hide
  updated_projects Project[] @relation("ProjectUpdatedBy")

  // Opposite relations for project member audit fields
  /// @hide
  deleted_project_members ProjectMember[] @relation("ProjectMemberDeletedBy")
  /// @hide
  created_project_members ProjectMember[] @relation("ProjectMemberCreatedBy")
  /// @hide
  updated_project_members ProjectMember[] @relation("ProjectMemberUpdatedBy")

  // Opposite relations for repository audit fields
  /// @hide
  deleted_repositories Repository[] @relation("RepositoryDeletedBy")
  /// @hide
  created_repositories Repository[] @relation("RepositoryCreatedBy")
  /// @hide
  updated_repositories Repository[] @relation("RepositoryUpdatedBy")

  @@unique([provider, provider_id])
  @@index([email])
  @@index([role, is_active])
  @@map("users")
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  jti         String   @unique @db.VarChar(36) // JWT ID - UUID embedded in token
  
  // Device identification
  device_id   String   @db.VarChar(255)
  device_name String?  @db.VarChar(255) // e.g., "iPhone 13", "My Gaming PC"
  
  user_id     String   @db.Uuid
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Security metadata
  ip_address  String?  @db.VarChar(45) // IPv6 max length
  user_agent  String?  @db.Text
  
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
  expires_at  DateTime
  revoked_at  DateTime? // Null = active, has value = revoked

  @@index([user_id, device_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}

model Student {
  id               String    @id @db.Uuid
  student_code     String?   @unique @db.VarChar(50)
  university_email String?   @db.VarChar(255)
  deleted_at       DateTime?
  deleted_by_id    String?   @db.Uuid
  /// @hide
  deleted_by       User?     @relation("StudentDeletedBy", fields: [deleted_by_id], references: [id], onDelete: NoAction)
  created_at       DateTime  @default(now())
  created_by_id    String?   @db.Uuid
  /// @hide
  created_by       User?     @relation("StudentCreatedBy", fields: [created_by_id], references: [id], onDelete: NoAction)
  updated_at       DateTime  @default(now()) @updatedAt
  updated_by_id    String?   @db.Uuid
  /// @hide
  updated_by       User?     @relation("StudentUpdatedBy", fields: [updated_by_id], references: [id], onDelete: NoAction)

  // Relations
  /// @hide
  user            User            @relation(fields: [id], references: [id], onDelete: NoAction)
  /// @hide
  github_mappings GithubMapping[]
  /// @hide
  enrollments     Enrollment[]
  /// @hide
  project_members ProjectMember[]

  @@index([student_code])
  @@index([university_email])
  @@map("students")
}

model Lecturer {
  id            String    @id @db.Uuid
  employee_code String?   @unique @db.VarChar(50)
  degree        String?   @db.VarChar(50)
  department    String?   @db.VarChar(100)
  phone_number  String?   @db.VarChar(20)
  deleted_at    DateTime?
  deleted_by_id String?   @db.Uuid
  /// @hide
  deleted_by    User?     @relation("LecturerDeletedBy", fields: [deleted_by_id], references: [id], onDelete: NoAction)
  created_at    DateTime  @default(now())
  created_by_id String?   @db.Uuid
  /// @hide
  created_by    User?     @relation("LecturerCreatedBy", fields: [created_by_id], references: [id], onDelete: NoAction)
  updated_at    DateTime  @default(now()) @updatedAt
  updated_by_id String?   @db.Uuid
  /// @hide
  updated_by    User?     @relation("LecturerUpdatedBy", fields: [updated_by_id], references: [id], onDelete: NoAction)

  // Relations
  /// @hide
  user    User    @relation(fields: [id], references: [id], onDelete: NoAction)
  /// @hide
  classes Class[]

  @@map("lecturers")
}

model GithubMapping {
  id              BigInt    @id @default(autoincrement())
  student_id      String    @db.Uuid
  github_email    String?   @db.VarChar(255)
  github_username String?   @db.VarChar(255)
  is_verified     Boolean   @default(false)
  deleted_at      DateTime?
  deleted_by_id   String?   @db.Uuid
  /// @hide
  deleted_by      User?     @relation("GithubMappingDeletedBy", fields: [deleted_by_id], references: [id], onDelete: NoAction)
  created_at      DateTime  @default(now())
  created_by_id   String?   @db.Uuid
  /// @hide
  created_by      User?     @relation("GithubMappingCreatedBy", fields: [created_by_id], references: [id], onDelete: NoAction)
  updated_at      DateTime  @default(now()) @updatedAt
  updated_by_id   String?   @db.Uuid
  /// @hide
  updated_by      User?     @relation("GithubMappingUpdatedBy", fields: [updated_by_id], references: [id], onDelete: NoAction)

  // Relations
  student Student @relation(fields: [student_id], references: [id], onDelete: NoAction)

  @@unique([github_email])
  @@unique([github_username])
  @@index([student_id, is_verified])
  @@index([is_verified])
  @@map("github_mappings")
}

// ============================================================================
// Academic Structure Models
// ============================================================================

model Semester {
  id            BigInt    @id @default(autoincrement())
  code          String    @unique @db.VarChar(50)
  name          String   @db.VarChar(100)
  start_date    DateTime? @db.Date
  end_date      DateTime? @db.Date
  is_active     Boolean   @default(true)
  deleted_at    DateTime?
  deleted_by_id String?   @db.Uuid
  /// @hide
  deleted_by    User?     @relation("SemesterDeletedBy", fields: [deleted_by_id], references: [id], onDelete: NoAction)
  created_at    DateTime  @default(now())
  created_by_id String?   @db.Uuid
  /// @hide
  created_by    User?     @relation("SemesterCreatedBy", fields: [created_by_id], references: [id], onDelete: NoAction)
  updated_at    DateTime  @default(now()) @updatedAt
  updated_by_id String?   @db.Uuid
  /// @hide
  updated_by    User?     @relation("SemesterUpdatedBy", fields: [updated_by_id], references: [id], onDelete: NoAction)

  // Relations
  classes Class[]
  @@index([is_active])
  @@index([start_date, end_date])
  @@map("semesters")
}

model Class {
  id            String    @id @db.Uuid @default(uuid())
  semester_id   BigInt
  lecturer_id   String    @db.Uuid
  course_id     String    @db.Uuid
  class_code    String   @db.VarChar(50)
  class_name    String   @db.VarChar(255)
  description   String?   @db.Text
  deleted_at    DateTime?
  deleted_by_id String?   @db.Uuid
  /// @hide
  deleted_by    User?     @relation("ClassDeletedBy", fields: [deleted_by_id], references: [id], onDelete: NoAction)
  created_at    DateTime  @default(now())
  created_by_id String?   @db.Uuid
  /// @hide
  created_by    User?     @relation("ClassCreatedBy", fields: [created_by_id], references: [id], onDelete: NoAction)
  updated_at    DateTime  @default(now()) @updatedAt
  updated_by_id String?   @db.Uuid
  /// @hide
  updated_by    User?     @relation("ClassUpdatedBy", fields: [updated_by_id], references: [id], onDelete: NoAction)

  // Relations
  /// @hide
  semester    Semester     @relation(fields: [semester_id], references: [id], onDelete: Cascade)
  /// @hide
  lecturer    Lecturer     @relation(fields: [lecturer_id], references: [id], onDelete: Restrict)
  /// @hide
  enrollments Enrollment[]
  /// @hide
  projects    Project[]
  // Relations
  /// @hide
  course      Course    @relation(fields: [course_id], references: [id], onDelete: Cascade)
  @@unique([course_id, semester_id, class_code])
  @@index([semester_id])
  @@index([lecturer_id])
  @@index([class_code])
  @@index([course_id])
  @@map("classes")
}
model Course {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(20) // Ví dụ: SWD392
  name        String   @db.VarChar(255)        // Software Architecture and Design
  deleted_at  DateTime?
  deleted_by_id String?   @db.Uuid
  /// @hide
  deleted_by    User?     @relation("CourseDeletedBy", fields: [deleted_by_id], references: [id], onDelete: NoAction)
  created_at    DateTime  @default(now())
  created_by_id String?   @db.Uuid
  /// @hide
  created_by    User?     @relation("CourseCreatedBy", fields: [created_by_id], references: [id], onDelete: NoAction)
  updated_at    DateTime  @default(now()) @updatedAt
  updated_by_id String?   @db.Uuid
  /// @hide
  updated_by    User?     @relation("CourseUpdatedBy", fields: [updated_by_id], references: [id], onDelete: NoAction)
  // Relations
  classes     Class[]  // Một môn học có thể mở nhiều lớp (SE1823, SE1824...)
  @@index([code])
  @@map("courses")
}


model Enrollment {
  id            BigInt    @id @default(autoincrement())
  class_id      String    @db.Uuid
  student_id    String    @db.Uuid
  total_score   Decimal?  @db.Decimal(5, 2)
  enrolled_at   DateTime  @default(now())
  deleted_at    DateTime?
  deleted_by_id String?   @db.Uuid
  /// @hide
  deleted_by    User?     @relation("EnrollmentDeletedBy", fields: [deleted_by_id], references: [id], onDelete: NoAction)
  created_at    DateTime  @default(now())
  created_by_id String?   @db.Uuid
  /// @hide
  created_by    User?     @relation("EnrollmentCreatedBy", fields: [created_by_id], references: [id], onDelete: NoAction)
  updated_at    DateTime  @default(now()) @updatedAt
  updated_by_id String?   @db.Uuid
  /// @hide
  updated_by    User?     @relation("EnrollmentUpdatedBy", fields: [updated_by_id], references: [id], onDelete: NoAction)

  // Relations
  /// @hide
  class   Class   @relation(fields: [class_id], references: [id], onDelete: Cascade)
  /// @hide
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([class_id, student_id])
  @@map("enrollments")
}

// ============================================================================
// Project & Repository Models
// ============================================================================

model Project {
  id            String    @id @db.Uuid @default(uuid())
  class_id      String    @db.Uuid
  name          String?   @db.VarChar(255)
  topic         String?   @db.VarChar(255)
  description   String?   @db.Text
  avatar_url    String?   @db.VarChar(500)
  deleted_at    DateTime?
  deleted_by_id String?   @db.Uuid
  /// @hide
  deleted_by    User?     @relation("ProjectDeletedBy", fields: [deleted_by_id], references: [id], onDelete: NoAction)
  created_at    DateTime  @default(now())
  created_by_id String?   @db.Uuid
  /// @hide
  created_by    User?     @relation("ProjectCreatedBy", fields: [created_by_id], references: [id], onDelete: NoAction)
  updated_at    DateTime  @default(now()) @updatedAt
  updated_by_id String?   @db.Uuid
  /// @hide
  updated_by    User?     @relation("ProjectUpdatedBy", fields: [updated_by_id], references: [id], onDelete: NoAction)

  // Relations
  /// @hide
  class           Class           @relation(fields: [class_id], references: [id], onDelete: Cascade)
  /// @hide
  project_members ProjectMember[]
  /// @hide
  repositories    Repository[]

  @@map("projects")
}

model ProjectMember {
  id            String            @id @db.Uuid @default(uuid())
  project_id    String            @db.Uuid
  student_id    String            @db.Uuid
  role          ProjectMemberRole
  joined_at     DateTime          @default(now())
  is_active     Boolean           @default(true)
  deleted_at    DateTime?
  deleted_by_id String?           @db.Uuid
  /// @hide
  deleted_by    User?             @relation("ProjectMemberDeletedBy", fields: [deleted_by_id], references: [id], onDelete: NoAction)
  created_at    DateTime          @default(now())
  created_by_id String?           @db.Uuid
  /// @hide
  created_by    User?             @relation("ProjectMemberCreatedBy", fields: [created_by_id], references: [id], onDelete: NoAction)
  updated_at    DateTime          @default(now()) @updatedAt
  updated_by_id String?           @db.Uuid
  /// @hide
  updated_by    User?             @relation("ProjectMemberUpdatedBy", fields: [updated_by_id], references: [id], onDelete: NoAction)

  // Relations
  /// @hide
  project Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  /// @hide
  student Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  /// @hide
  commits Commit[]

  @@unique([project_id, student_id])
  @@map("project_members")
}

model Repository {
  id                     String    @id @db.Uuid @default(uuid())
  project_id             String    @db.Uuid
  url                    String    @db.VarChar(500)
  name                   String    @db.VarChar(255)
  organization           String    @db.VarChar(255)
  owner                  String    @db.VarChar(255)
  encrypted_access_token String    @db.Text
  token_iv               String    @db.VarChar(255)
  last_scanned_at        DateTime?
  scan_status            String    @db.VarChar(50)
  error_message          String    @db.Text
  deleted_at             DateTime?
  deleted_by_id          String?   @db.Uuid
  /// @hide
  deleted_by             User?     @relation("RepositoryDeletedBy", fields: [deleted_by_id], references: [id], onDelete: NoAction)
  created_at             DateTime  @default(now())
  created_by_id          String?   @db.Uuid
  /// @hide
  created_by             User?     @relation("RepositoryCreatedBy", fields: [created_by_id], references: [id], onDelete: NoAction)
  updated_at             DateTime  @default(now()) @updatedAt
  updated_by_id          String?   @db.Uuid
  /// @hide
  updated_by             User?     @relation("RepositoryUpdatedBy", fields: [updated_by_id], references: [id], onDelete: NoAction)

  // Relations
  /// @hide
  project   Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  /// @hide
  commits   Commit[]
  /// @hide
  sync_logs SyncLog[]

  @@index([project_id])
  @@index([scan_status])
  @@index([last_scanned_at])
  @@index([project_id, scan_status])
  @@map("repositories")
}

model Commit {
  id                String    @id @db.Uuid @default(uuid())
  repository_id     String    @db.Uuid
  project_member_id String    @db.Uuid
  message           String?   @db.Text
  author_name_raw   String?   @db.VarChar(255)
  author_email_raw  String?   @db.VarChar(255)
  committed_date    DateTime?
  additions         Int?
  deletions         Int?
  files_changed     Int?
  hash              String?   @db.VarChar(64)
  deleted_at        DateTime?
  created_at        DateTime  @default(now())

  // Relations
  /// @hide
  repository     Repository     @relation(fields: [repository_id], references: [id], onDelete: Cascade)
  /// @hide
  project_member ProjectMember? @relation(fields: [project_member_id], references: [id], onDelete: Cascade)

  @@unique([repository_id, hash])
  @@index([repository_id, committed_date])
  @@index([author_email_raw])
  @@index([committed_date])
  @@index([hash])
  @@map("commits")
}

model SyncLog {
  id                String    @id @db.Uuid @default(uuid())
  repository_id     String    @db.Uuid
  trigger_type      String?   @db.VarChar(50)
  started_at        DateTime?
  completed_at      DateTime?
  status            String?   @db.VarChar(50)
  commits_found     Int?
  commits_inserted  Int?
  execution_time_ms Int?
  log_message       String?   @db.Text

  // Relations
  /// @hide
  repository Repository @relation(fields: [repository_id], references: [id], onDelete: Cascade)

  @@index([repository_id])
  @@index([status])
  @@index([started_at])
  @@map("sync_logs")
}

enum UserRole {
  ADMIN
  STUDENT
  LECTURER
}

enum ProjectMemberRole {
  LEADER
  MEMBER
}
